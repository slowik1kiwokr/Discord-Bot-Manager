# --- Python cache ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class

# --- Virtuális környezet ---
venv/
env/
.venv/
ENV/

# --- Felhasználói adatok (SZEMÉLYES!) ---
bots.json
settings.json
lang.json
local_version.txt
panel_stats.json
achievements.json
streak.json
panel_broadcast_requests.json
panel_commands.json
errors.txt
temp_app_icon.ico

# --- KIVÉTELEK: sablonok, amiket fel KELL tenni ---
# Ha valamikor sablonokat akarsz feltölteni, nevezd el így:
!*.example.json
!*.template.json
!*.default.json
!*.sample.json
!templates/
!templates/*.json

# --- Mappák (személyes adatok) ---
backups/
logs/
plugins/
panel_responses/
bot/
bots/
dc_botok/
data/
update_extract/

# --- Ideiglenes fájlok ---
update.zip
_icon_temp.ico
*.tmp
*.bak
*.log

# --- Régi ikonok ---
dc_icon.ico
dc_logo.ico

# --- Batch indítók ---
start.bat
Inditas.bat
*.bat

# --- PyInstaller / build ---
build/
dist/
*.spec

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# --- Operációs rendszer ---
.DS_Store
Thumbs.db
Desktop.ini
