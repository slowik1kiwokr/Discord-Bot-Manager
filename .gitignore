# ============================================================
#  DBM PANEL — Git kizárások
#  Ezeket a fájlokat/mappákat NE kövesse a git
# ============================================================

# --- Python cache ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class

# --- Virtuális környezet ---
venv/
env/
.venv/
ENV/

# --- Felhasználói adatok (személyes!) ---
bots.json
settings.json
lang.json
local_version.txt
panel_stats.json
achievements.json
streak.json
panel_broadcast_requests.json
panel_commands.json
errors.txt

# --- Mappák (személyes adatok) ---
backups/
logs/
plugins/
panel_responses/
bot/
bots/
dc_botok/
data/
update_extract/

# --- Ideiglenes fájlok ---
update.zip
_icon_temp.ico
temp_app_icon.ico
*.tmp
*.bak
*.log

# --- Régi ikonok (már nem használt) ---
dc_icon.ico
dc_logo.ico

# --- PyInstaller / build ---
build/
dist/
*.spec

# --- IDE / szerkesztő ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# --- Operációs rendszer ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Git ---
.git/
.github/
.gitignore

# --- Egyéb ---
*.zip
*.tar
*.gz
*.7z
*.rar
node_modules/